{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "title": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "mcp": {
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      }
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 10000
  }
}
